# pnpm-related options
#shamefully-hoist=true
#strict-peer-dependencies=false
# to get the latest compatible packages when creating the project https://github.com/pnpm/pnpm/issues/6463
# resolution-mode=highest

@jsr:registry=https://npm.jsr.io

# Installs are engine-strict: a Node that cannot build this project is refused at `npm install`
# rather than at the first build (#203).
#
# Know what this costs before changing a dependency. It applies to every dependency's `engines`,
# not only ours, so a transitive package tightening its range fails the install outright, here and
# in CI. That is not hypothetical — while `.nvmrc` pinned 24.14.0, `mute-stream@4.0.0` requiring
# `^24.15.0` was enough to stop this project installing on its own pinned Node.
#
# So when an install starts failing with EBADENGINE for a package nobody touched, the cause is a
# dependency's floor rising past `.nvmrc`, and the fix is to raise the pin — not to delete this
# line. Check that Quasar still supports the newer Node first: it enforces a floor at runtime that
# its own `engines` field does not declare.
engine-strict=true
