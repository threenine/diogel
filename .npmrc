# pnpm-related options
#shamefully-hoist=true
#strict-peer-dependencies=false
# to get the latest compatible packages when creating the project https://github.com/pnpm/pnpm/issues/6463
# resolution-mode=highest

@jsr:registry=https://npm.jsr.io

# Deliberately NOT engine-strict.
#
# It applies to every dependency's `engines`, not only ours, so any transitive package tightening
# its range turns into a blocking install failure here and in CI. That is not hypothetical: while
# `.nvmrc` pinned 24.14.0, `mute-stream@4.0.0` requiring `^24.15.0` was enough to stop this project
# installing on its own pinned Node.
#
# The pin is 24.19.0 now and strict mode would pass today. The reason still stands — it hands
# control of whether this project installs to the strictest `engines` field in the tree — so it
# stays off, and the correct `engines.node` range provides the install-time warning instead (#203).
