# pnpm-related options
#shamefully-hoist=true
#strict-peer-dependencies=false
# to get the latest compatible packages when creating the project https://github.com/pnpm/pnpm/issues/6463
# resolution-mode=highest

@jsr:registry=https://npm.jsr.io

# Deliberately NOT engine-strict. It applies to every dependency's `engines`, not only ours, so a
# transitive package tightening its range breaks the install outright — `mute-stream@4.0.0` already
# requires `^24.15.0` while `.nvmrc` pins 24.14.0, which means strict mode cannot install this
# project on its own pinned Node. The correct `engines.node` range makes npm warn at install time,
# which is the signal that was missing (#203).
